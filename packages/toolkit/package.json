{
  "name": "@compforge/doctor-toolkit",
  "version": "0.0.1",
  "description": "Shared infrastructure and data access for Doctor hosts and plugins",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "exports": {
    ".": "./src/datasource.ts",
    "./datasource": "./src/datasource.ts",
    "./transport": "./src/transport/index.ts",
    "./process": "./src/process/index.ts",
    "./process/index": "./src/process/index.ts",
    "./kubernetes/*": "./src/kubernetes/*.ts",
    "./mysql": "./src/mysql/index.ts",
    "./mysql/*": "./src/mysql/*.ts",
    "./redis": "./src/redis/index.ts",
    "./redis/*": "./src/redis/*.ts",
    "./opensearch": "./src/opensearch/index.ts",
    "./opensearch/*": "./src/opensearch/*.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "mysql2": "3.23.1",
    "@redis/client": "6.1.0",
    "@opensearch-project/opensearch": "3.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
